{
    "name": "eloquage/chunk-ext",
    "description": "Optional PIE-compatible TypePHP native extension for eloquage/chunk.",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "php-ext": {
      "extension-name": "eloquage_chunk"
    },
    "extra": {
        "pie": {
            "download-method": "pre-packaged-binary",
            "asset-prefix": "php_eloquage_chunk",
            "php-version": "8.5",
            "architecture": "x86_64",
            "os": "Linux",
            "libc": "glibc",
            "thread-safety": "NTS"
        }
    },
    "homepage": "https://github.com/eloquage/chunk-ext",
    "support": {
        "source": "https://github.com/eloquage/chunk-ext"
    }
}
